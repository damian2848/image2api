# This file is installed to /etc/image2api/updater.env and is not committed
# with real values. Generate the token with: openssl rand -hex 32
UPDATER_TOKEN=replace-with-a-random-64-character-token
IMAGE2API_REPO=/opt/image2api
IMAGE2API_GITHUB_REPO=damian2848/image2api
IMAGE2API_COMPOSE_FILES=docker-compose.yml,docker-compose.prod.yml
# Bind only to Docker's bridge address. It is reachable by the backend
# container through host.docker.internal but is not exposed on public NICs.
IMAGE2API_UPDATER_LISTEN=172.17.0.1:7070
